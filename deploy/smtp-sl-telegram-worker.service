[Unit]
Description=SMTP_SL Telegram notification worker
After=network-online.target smtp-sl.service

[Service]
User=smtp_sl
Group=smtp_sl
WorkingDirectory=/opt/smtp_sl/app
EnvironmentFile=/etc/smtp_sl.env
ExecStart=/opt/smtp_sl/venv/bin/python manage.py process_tasks --queue telegram --sleep 2
Restart=always
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
